{
  "name": "openskylight",
  "version": "0.8.0",
  "description": "LAN-hosted family calendar display and parent administration service",
  "author": "Tyler",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "22.13.x",
    "npm": ">=10 <12"
  },
  "overrides": {
    "webworkify-webpack": "2.1.5"
  },
  "scripts": {
    "dev": "node scripts/dev-web.mjs",
    "dev:server": "npm run build:server && npm run start:server",
    "dev:kiosk": "vite --config kiosk.vite.config.ts",
    "dev:companion": "vite --config companion.vite.config.ts",
    "build": "npm run build:server && npm run build:kiosk && npm run build:companion",
    "build:server": "tsc -p tsconfig.server.json",
    "build:kiosk": "vite build --config kiosk.vite.config.ts",
    "build:companion": "vite build --config companion.vite.config.ts",
    "deploy:home": "node scripts/deploy-home.mjs",
    "start:server": "node out/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "test:admin-shell": "npm run build:companion && node scripts/e2e-admin-shell.mjs",
    "test:phone-people": "npm run build:companion && node scripts/e2e-phone-people-calendars.mjs",
    "test:phone-chores": "npm run build:companion && node scripts/e2e-phone-chores-rewards.mjs",
    "test:phone-planning": "npm run build:companion && node scripts/e2e-phone-planning.mjs",
    "test:phone-displays": "npm run build:companion && node scripts/e2e-phone-displays-diagnostics.mjs",
    "test:kiosk-browser": "npm run build:kiosk && npm run build:server && node scripts/e2e-kiosk-browser.mjs",
    "test:kiosk-connectivity": "npm run build:kiosk && npm run build:server && node scripts/e2e-kiosk-connectivity.mjs",
    "test:operations": "node ./node_modules/vitest/vitest.mjs run tests/unit/operations.test.ts",
    "test:multi-display": "npm run build:kiosk && npm run build:server && node scripts/e2e-multi-display.mjs",
    "screenshots:personalization": "node scripts/capture-personalization-prototype.mjs"
  },
  "dependencies": {
    "@googleapis/calendar": "^15.0.0",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.8.0",
    "google-auth-library": "^10.7.0",
    "ical.js": "^2.2.1",
    "luxon": "^3.5.0",
    "rrule": "^2.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.1.0",
    "@fontsource-variable/nunito": "^5.1.0",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-query": "^5.66.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.13.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.8",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.60.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-simple-keyboard": "^3.8.27",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "zustand": "^5.0.3"
  },
  "allowScripts": {
    "better-sqlite3@12.10.0": true,
    "esbuild@0.25.12": true
  }
}
