{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm test)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run build:server)",
      "Bash(npm run build:kiosk)",
      "Bash(npm run build:companion)",
      "Bash(npx vitest run *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh workflow *)"
    ],
    "ask": [
      "Bash(npm run deploy:home *)"
    ],
    "deny": [
      "Bash(git push --force*)"
    ]
  },
  "worktree": {
    "symlinkDirectories": ["node_modules"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-destructive.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking for destructive commands"
          }
        ]
      }
    ]
  }
}
