# The same LAN URL that serves the kiosk's index.html and /api routes.
# Use an IP address or a LAN-only DNS name that the Pi can resolve at boot.
OSL_KIOSK_URL=http://192.168.1.25:3000/

# Raspberry Pi OS's Chromium command is normally chromium-browser.
OSL_CHROMIUM_BIN=chromium-browser

# Pointer hiding requires the X11 package unclutter-xfixes.
OSL_HIDE_POINTER=true

# The host, not OpenSkyLight, owns display power. Set on to allow the desktop
# session's DPMS policy, or off to keep the panel awake continuously.
OSL_DPMS=on
